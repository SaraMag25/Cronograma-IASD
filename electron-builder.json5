{
  appId: "com.cronograma.iasd",
  productName: "Cronograma IASD",
  directories: {
    output: "release/${version}"
  },
  files: [
    "dist/**/*",
    "package.json"
  ],
  win: {
    target: [
      {
        target: "nsis", // Gera o instalador padrão unificado
        arch: ["x64"]
      }
    ]
  },
  nsis: {
    oneClick: false,
    allowToChangeInstallationDirectory: true,
    installerIcon: "build/icon.ico",
    uninstallerIcon: "build/icon.ico",
    shortcutName: "Cronograma IASD"
  }
}